      propertyPath: 'dialogue.lines.Array.data[0]'
      value: An old poster of Paracelsus, a classic. It's gotta cost a huge fortune
        though.
      objectReference: {fileID: 0}
    - target: {fileID: 6235277073552685766, guid: 4f21f6b62cb96924f91559072532ffad, type: 3}
