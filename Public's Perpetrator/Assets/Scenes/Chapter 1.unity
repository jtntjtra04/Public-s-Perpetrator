  m_Script: {fileID: 11500000, guid: d69386bbf259070458282b0daae99b17, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    names:
    - 
    - Paul
    - Paul
    - Paul
    - 
    - 
    - 
    - Paul
    - Paul
    lines:
    - A large bloody mess remains to stain the floors of the bedroom..
    - ...
    - This is way worse than I imagined..
    - Am I witnessing.. the aftermath of a massacre..?
    - Countless possibilties begin to clog your inner thoughts as your feet approaches
      more of these red spots..
    - Are you stepping into the house of a murderer? Have you gone into a death trap
      all this time? Or rather..
    - Is there more to this than your typical straightforward murder case..?
    - Hmm.. but I have yet to witness a body or remains of at least what used to
      be.. human..
    - There's gotta be more than what meets the eye..
    images:
    - {fileID: -3192516492055939191, guid: 6730911efd719bc48a9da7e5a9bb3f72, type: 3}
